# Base path of the API gateway as seen by the browser (the SPA is served by the same gateway).
VITE_API_BASE=/api
# Seconds before access-token expiry at which the SPA refreshes it.
VITE_REFRESH_LEEWAY=60
# Only for `npm run dev`: where Vite proxies /api to.
VITE_DEV_API_TARGET=http://localhost:8080
