APP_NAME=finance-service
APP_ENV=production
APP_DEBUG=false
# Laravel encrypter key (not used for auth). Generate with: php artisan key:generate --show
APP_KEY=base64:Qf3r8Jm1tZ4kV7nB2xC5yH0wL9pS6dE3aG8uK1oN4iM=
APP_URL=http://localhost:8003

LOG_CHANNEL=stderr
LOG_LEVEL=info
CACHE_STORE=file

DB_CONNECTION=mysql
DB_HOST=db_finance
DB_PORT=3306
DB_DATABASE=db_finance
DB_USERNAME=finance
DB_PASSWORD=finance_secret

# Service URLs (docker network names)
AUTH_SERVICE_URL=http://auth-service:8000
POS_SERVICE_URL=http://pos-service:8000
# Shared secret for /internal/* (sent/checked as X-Service-Key). Must match POS.
INTERNAL_API_KEY=change-me-internal-service-key
# Timeout in seconds for every outbound service call
SERVICE_HTTP_TIMEOUT=3
