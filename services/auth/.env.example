APP_NAME=auth-service
APP_ENV=production
APP_DEBUG=false
# Not used for JWT; Laravel requires a key for its encrypter. Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8001

LOG_CHANNEL=stderr
LOG_LEVEL=info
CACHE_STORE=file

DB_CONNECTION=mysql
DB_HOST=db_auth
DB_PORT=3306
DB_DATABASE=db_auth
DB_USERNAME=auth
DB_PASSWORD=

# HS256 signing secret (min. 32 chars). Only the Auth Service knows it; other services validate via GET /auth/me.
JWT_SECRET=
JWT_ISSUER=auth-service
# Access token lifetime in seconds (15 minutes)
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (7 days)
JWT_REFRESH_TTL=604800
