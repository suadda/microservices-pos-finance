APP_NAME=pos-service
APP_ENV=production
APP_DEBUG=false
# Laravel encrypter key (not used for auth). Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8002

LOG_CHANNEL=stderr
LOG_LEVEL=info
CACHE_STORE=file

DB_CONNECTION=mysql
DB_HOST=db_pos
DB_PORT=3306
DB_DATABASE=db_pos
DB_USERNAME=pos
DB_PASSWORD=

# PPN rate applied to (subtotal - discount_amount)
TAX_RATE=0.11

# Service URLs (docker network names)
AUTH_SERVICE_URL=http://auth-service:8000
FINANCE_SERVICE_URL=http://finance-service:8000
# Shared secret for /internal/* (sent/checked as X-Service-Key). Must match Finance.
INTERNAL_API_KEY=
# Timeout in seconds for every outbound service call
SERVICE_HTTP_TIMEOUT=3
