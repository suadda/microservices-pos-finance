# Copy to .env (gitignored) and fill EVERY value before `docker compose up`.
# docker compose reads this file automatically; missing secrets make compose stop with an error.
#
# Generate values (any shell with openssl):
#   APP_KEY_*   : echo "base64:$(openssl rand -base64 32)"
#   JWT_SECRET  : openssl rand -base64 48
#   others      : openssl rand -hex 24
# Or PowerShell:  [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])

# Laravel encrypter keys, one per service (never reuse, never commit)
APP_KEY_AUTH=
APP_KEY_POS=
APP_KEY_FINANCE=

# HS256 signing secret for access tokens (min. 32 chars). Only the Auth Service uses it.
JWT_SECRET=

# Shared secret for /internal/* calls between POS and Finance (X-Service-Key header)
INTERNAL_API_KEY=

# MySQL credentials (one isolated database per service)
DB_AUTH_ROOT_PASSWORD=
DB_AUTH_PASSWORD=
DB_POS_ROOT_PASSWORD=
DB_POS_PASSWORD=
DB_FINANCE_ROOT_PASSWORD=
DB_FINANCE_PASSWORD=

# First superadmin, created on start only if this email does not exist yet (min. 12-char password).
# Remove the password from .env after the first successful login and change it in the UI.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local testing only: seeds the *@demo.test accounts with a shared password (needed by scripts/e2e-scenarios.sh).
# Keep false on any machine reachable by others.
SEED_DEMO_USERS=false

# Optional
GATEWAY_PORT=8080
TAX_RATE=0.11
