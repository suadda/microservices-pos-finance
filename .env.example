# OPTIONAL. `docker compose up -d --build` works without this file: the `secrets-init` service generates
# every secret once into the `secrets` volume and keeps it across restarts.
#
# Copy to .env (gitignored) only to override something. A non-empty secret here replaces the stored one.
# MySQL applies DB_* passwords only when its volume is first created; to change them later run
# `docker compose down -v` (deletes data) or change the MySQL user password manually.

# --- secrets (leave empty to auto-generate) ---
APP_KEY_AUTH=
APP_KEY_POS=
APP_KEY_FINANCE=
JWT_SECRET=
INTERNAL_API_KEY=
DB_AUTH_ROOT_PASSWORD=
DB_AUTH_PASSWORD=
DB_POS_ROOT_PASSWORD=
DB_POS_PASSWORD=
DB_FINANCE_ROOT_PASSWORD=
DB_FINANCE_PASSWORD=

# --- accounts ---
# Test accounts listed in README (shared password). Set to false on any public deployment;
# existing demo accounts are then deactivated on the next start.
SEED_DEMO_USERS=true
# Optional own superadmin, created once if the email does not exist yet (min. 12-char password).
ADMIN_NAME=Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- misc ---
GATEWAY_PORT=8080
TAX_RATE=0.11
